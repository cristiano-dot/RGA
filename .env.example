# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# --- Email (optional) ---
# Without this, every email the app would send (RGA decisions, admin
# comments, password resets) is logged to the server console instead of
# actually sent — the app works fine without it, this just enables real
# delivery. Sign up at https://resend.com and create an API key.
RESEND_API_KEY=

# Optional: the From address for outgoing email. Until you verify a sending
# domain in Resend, leave unset — it defaults to Resend's shared sandbox
# sender, which works for testing but isn't meant for real users.
EMAIL_FROM=

# --- Session signing ---
# Any long random string — `openssl rand -hex 32` is a good way to make one.
# Used to sign session cookies, so anyone who knows it can mint a session for
# any account, including an admin. Optional for local dev (a dev-only default
# is used if unset); required for anything shared. In production the app
# refuses to fall back to the shipped default: it logs an error and signs with
# a random per-process secret instead, so sessions stop surviving restarts
# until this is set.
SESSION_SECRET=
