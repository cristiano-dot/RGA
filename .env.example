# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# --- Rep sign-in (Google OAuth) ---
# Create these in Google Cloud Console: APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Web application.
# Authorized redirect URI (dev): http://localhost:3000/api/auth/google/callback
# Authorized redirect URI (prod): https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: your company's Google Workspace domain (e.g. smithcorona.com).
# When set, any employee who signs in with a @<this domain> Google account
# is automatically added as a sales rep on first login. Leave unset to
# require an admin to add each rep's email to sales_reps manually.
GOOGLE_WORKSPACE_DOMAIN=

# --- Session signing ---
# Any long random string. Used to sign session cookies.
SESSION_SECRET=
